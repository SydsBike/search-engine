// tsconfig.json — read by `tsc` and by VSCode's TypeScript language server.
// It governs TYPE CHECKING, not running. tsx/esbuild strip types without
// reading this file, so nothing here affects how the code executes.
//
// Comments are legal here (TypeScript ships its own config parser that allows
// them). They are NOT legal in package.json, which is strict JSON.
//
// Note: `include` and `exclude` are TOP-LEVEL keys, siblings of
// "compilerOptions" — not members of it. Add them outside this object.
{
    "compilerOptions": {
        // Umbrella flag: turns on ~8 checks at once. The two that matter most:
        //   noImplicitAny   — an untyped parameter is an error, not a silent
        //                     `any` (which would disable checking entirely).
        //   strictNullChecks — null/undefined aren't assignable to everything,
        //                     so "this page had no <title>" must be handled
        //                     at the point it's written, not at crawl time.
        "strict": true,

        // "Do what modern Node does." Makes TypeScript read package.json's
        // "type" field — currently "module", so .ts files are treated as ESM.
        // Also sets module resolution automatically (no separate line needed).
        // Consequence: relative imports must carry a file extension — see
        // allowImportingTsExtensions below for which extension.
        "module": "nodenext",

        // Which JavaScript version the code is checked against. Decides what
        // syntax is legal and which built-in APIs are typed (es2023 includes
        // things like Array.prototype.findLast). Node 24 supports more than
        // this — a deliberately conservative floor, easy to raise later.
        "target": "es2023",

        // Don't write any .js files. By default tsc emits a .js next to every
        // .ts; tsx already handles running, so those would just be clutter
        // needing their own gitignore entries. With this, `npx tsc` becomes a
        // pure checker: it reports problems and produces nothing.
        "noEmit": true,

        // Relative imports name the file actually on disk — "./url.ts" — instead
        // of the default convention (the OUTPUT extension, "./url.js"), which
        // here would point at a file that never exists: noEmit is on and tsx
        // runs the .ts directly. Only legal because noEmit is true.
        // Decided 2026-09-07. Accepted cost, stated once: switching to compiled
        // output later means changing every relative import.
        "allowImportingTsExtensions": true
    },
    // Only search src directory for .ts files
    "include": ["src"]
}
